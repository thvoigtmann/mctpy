    plt.plot(msd.t, msd.phi)
plt.xscale('log')
plt.yscale('log')
plt.show()
```

```{code-cell} ipython3
for phi in correlators:
    plt.plot(phi.t,phi.shear_modulus())
plt.xscale('log')
plt.show()
```

```{code-cell} ipython3
def cc_modulus (self, phi, t):
    import scipy
    rho = np.sqrt(np.outer(self.densities,self.densities))
    cq = self.Sq.cq(self.q)
    sum1 = 'gd,...ag,...bd,...ab,...gd->...ab'
    sum2 = 'gd,...ag,...bd,...gb,...ad->...ab'
    inner = np.einsum(sum1,rho,cq,cq,phi,phi) - np.einsum(sum2,rho,cq,cq,phi,phi)
    qw = self.dq() * self.q**4
    return scipy.integrate.trapezoid(
            qw[...,None,None] * inner, axis=-3) / (6.*np.pi**2)
```

```{code-cell} ipython3
for phi in correlators:
    Mcc = cc_modulus(phi.model,phi.phi,phi.t)
    x = phi.model.densities/phi.model.rho
    plt.plot(phi.t,Mcc[:,0,0]*x[0],linestyle='solid')
    plt.plot(phi.t,Mcc[:,1,1]*x[1],linestyle='dashed')
    plt.plot(phi.t,-Mcc[:,0,1]*np.sqrt(x[0]*x[1]),linestyle='dotted')
plt.xscale('log')
plt.show()
```

```{code-cell} ipython3
import scipy
for phi in correlators:
    Mcc = cc_modulus(phi.model,phi.phi,phi.t)
    x = phi.model.densities/phi.model.rho
    Laa = x[1]/scipy.integrate.trapezoid(Mcc[:,0,0],x=phi.t)
    Lbb = x[0]/scipy.integrate.trapezoid(Mcc[:,1,1],x=phi.t)
    Lab = -np.sqrt(x[0]*x[1])/scipy.integrate.trapezoid(Mcc[:,0,1],x=phi.t)
    print(Laa,Lbb,Lab)
```

```{code-cell} ipython3
philist = []
xblist = np.linspace(0,1,11)
for xb in xblist:
    sq = mct.structurefactors.hsmPY(*hsm_densities(d).volume_fractions(phi=packing_fraction, xhat=xb))
    x = sq.densities/np.sum(sq.densities)
    s0, _ = sq.Sq(0)
    Phiinv = x[1]*s0[0,0] + x[0]*s0[1,1] - 2*np.sqrt(x[0]*x[1])*s0[0,1]
    philist.append(1./Phiinv)
plt.plot(xblist,philist)
plt.show()
```

